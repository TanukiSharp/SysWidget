<Window x:Class="SysWidget.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:SysWidget.Behaviors"
        xmlns:conv="clr-namespace:SysWidget.Converters"
        xmlns:vm="clr-namespace:SysWidget.ViewModels"
        Title="SysWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="17"
        behaviors:WidgetPlacement.Enabled="True"
        behaviors:WidgetPlacement.WindowLeft="{Binding WindowLeft, Mode=TwoWay}"
        behaviors:WidgetPlacement.WindowTop="{Binding WindowTop, Mode=TwoWay}"
        behaviors:WidgetPlacement.ResetPositionToken="{Binding PositionResetToken}">

    <Window.Resources>
        <conv:FirstItemToVisibilityConverter x:Key="FirstItemToVisibility" />
        <conv:FractionToColorConverter x:Key="FractionToColor" />
        <conv:FractionToHeightConverter x:Key="FractionToHeight" />

        <!-- Leading separator shown on every cell except the first. -->
        <Style x:Key="Separator" TargetType="TextBlock">
            <Setter Property="Text" Value="│" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Opacity" Value="0.35" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility"
                    Value="{Binding (ItemsControl.AlternationIndex),
                                    RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                    Converter={StaticResource FirstItemToVisibility}}" />
        </Style>

        <!-- Text component (e.g. network): label + value only. -->
        <DataTemplate DataType="{x:Type vm:ComponentViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        behaviors:RatchetWidth.Enabled="True"
                        behaviors:RatchetWidth.ResetToken="{Binding DataContext.SizeResetToken,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <TextBlock Style="{StaticResource Separator}" />
                <TextBlock Text="{Binding Label}" Opacity="0.55" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- Gauge component (CPU, RAM): vertical green-to-red bar + value text. -->
        <DataTemplate DataType="{x:Type vm:GaugeComponentViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        behaviors:RatchetWidth.Enabled="True"
                        behaviors:RatchetWidth.ResetToken="{Binding DataContext.SizeResetToken,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <TextBlock Style="{StaticResource Separator}" />
                <TextBlock Text="{Binding Label}" Opacity="0.55" Margin="0,0,6,0" VerticalAlignment="Center" />
                <Border Width="6" Height="20" CornerRadius="1" Background="#40808080" VerticalAlignment="Center">
                    <Border VerticalAlignment="Bottom" CornerRadius="1"
                            Background="{Binding Raw, Converter={StaticResource FractionToColor}}"
                            Height="{Binding Raw, Converter={StaticResource FractionToHeight}, ConverterParameter=20}" />
                </Border>
                <TextBlock Text="{Binding Text}" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Components" ItemsSource="{Binding AvailableComponents}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding DisplayName}" />
                        <Setter Property="IsCheckable" Value="True" />
                        <Setter Property="IsChecked" Value="{Binding IsActive, Mode=TwoWay}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator />
            <MenuItem Header="Dark theme" IsCheckable="True" IsChecked="{Binding IsDark, Mode=OneWay}"
                      Command="{Binding ToggleThemeCommand}" />
            <MenuItem Header="Start with Windows" IsCheckable="True"
                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
            <MenuItem Header="Desktop switch overlay" IsCheckable="True"
                      IsChecked="{Binding ShowDesktopSwitch, Mode=TwoWay}" />
            <MenuItem Header="Reset size" Command="{Binding ResetSizeCommand}" />
            <MenuItem Header="Reset position" Command="{Binding ResetPositionCommand}" />
            <Separator />
            <MenuItem Header="About SysWidget…" Command="{Binding AboutCommand}" />
            <MenuItem Header="Quit" Command="{Binding QuitCommand}" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Root carries a near-transparent fill with alpha = 1/255 (visually invisible).
         With AllowsTransparency the window is a per-pixel-alpha layered window, and
         pixels with alpha exactly 0 (a plain Transparent brush) are click-through at
         the OS level — the mouse passes straight through the gaps between glyphs. A
         minimal non-zero alpha keeps every pixel hit-testable, so hover detection and
         drag work everywhere on the widget, not just over text and gauges. -->
    <Grid x:Name="Root" Background="#01000000">
        <Border x:Name="BackgroundLayer" CornerRadius="8" Opacity="{Binding Opacity}">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- Transparent by default so only the components show; the drag
                         zone gets a solid coloured fill only while hovered. -->
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <!-- Hover, light theme -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, ElementName=Root}" Value="True" />
                                <Condition Binding="{Binding IsDark}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#F4F4F4" />
                        </MultiDataTrigger>
                        <!-- Hover, dark theme -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, ElementName=Root}" Value="True" />
                                <Condition Binding="{Binding IsDark}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#1E1E1E" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <ItemsControl ItemsSource="{Binding Components}"
                      AlternationCount="99"
                      Margin="12,6"
                      VerticalAlignment="Center">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="TextElement.Foreground" Value="#202020" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDark}" Value="True">
                            <Setter Property="TextElement.Foreground" Value="#F0F0F0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</Window>
